# PUBLIC VALUES ONLY — Firebase web config is public by design (it identifies the
# project; access is enforced by Auth + security rules), so the real .env may be
# committed. Never put a service-account key or any other secret here.
#
# Copy to .env and fill from Firebase console → Project settings → Your apps → Web app.
# The placeholder values below are enough for `npm run build` and `npm test`.
VITE_FIREBASE_API_KEY=AIzaSy-placeholder-not-a-real-key
VITE_FIREBASE_PROJECT_ID=your-project-id
# Same origin as the Hosting site (NOT <project>.firebaseapp.com), so
# signInWithRedirect works in the iOS home-screen PWA. See README.
VITE_FIREBASE_AUTH_DOMAIN=your-hosting-site.web.app
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Web Push (VAPID) public key — Firebase console → Cloud Messaging → Web Push
# certificates → Generate key pair. Public by design. Leave empty and push stays off.
VITE_FIREBASE_VAPID_KEY=
